{
	"name": "adb-plugin-reminders",
	"displayName": "Reminders",
	"version": "1.3.0",
	"description": "Adds /remind to set, list, and cancel personal reminders. Delivers via DM with a channel fallback.",
	"author": "DeadIndian",
	"main": "index.js",
	"requiresRestart": false,
	"isolation": true,
	"manifestVersion": 2,
	"process": {
		"model": "pooled",
		"maxExecutionMs": 5000,
		"memoryMb": 128,
		"persistentReason": null
	},
	"capabilities": {
		"storage": ["own-collection"],
		"discord": ["SendMessages"],
		"scheduler": ["cron"]
	},
	"permissions": {
		"storage": ["own-collection"],
		"discord": ["SendMessages"],
		"scheduler": ["cron"],
		"hooks": ["subscribe"],
		"network": { "outbound": [] },
		"filesystem": { "read": [], "write": [] },
		"childProcess": false,
		"nativeAddons": false
	},
	"declaredDependencies": [],
	"engines": {
		"core": ">=2.0.0",
		"plugins": { "administration": ">=2.0.0" }
	},
	"settings": {
		"commandPermissions": true,
		"schema": [
			{ "key": "maxPerUser", "type": "number", "label": "Max reminders per user" }
		]
	},
	"discordPermissions": ["SendMessages"],
	"webUi": {
		"memberPages": [
			{
				"path": "/me/reminders",
				"label": "My Reminders",
				"icon": "Clock",
				"source": { "model": "reminder", "scope": "member", "sort": { "remindAt": 1 }, "limit": 200 },
				"view": {
					"type": "table",
					"empty": "You have no reminders set in this server.",
					"columns": [
						{ "field": "message", "label": "Reminder" },
						{ "field": "remindAt", "label": "When" },
						{ "field": "notified", "label": "Sent" }
					],
					"actions": [
						{ "id": "cancel", "label": "Cancel", "op": "delete" }
					]
				}
			}
		]
	},
	"configSchema": {
		"type": "object",
		"properties": {
			"maxPerUser": {
				"type": "number",
				"default": 25,
				"minimum": 1,
				"maximum": 200,
				"description": "Max active reminders a single user can have per server"
			}
		}
	}
}